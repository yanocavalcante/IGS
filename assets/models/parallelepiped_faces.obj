# Parallelepiped wireframe, 80 x 120 x 80, edges derived from "f" faces
# (indices with /vt/vn and negative indices are also exercised).
# Requirements: load a wireframe .obj parallelepiped and view it in perspective.
o parallelepiped_faces
v -40 -60 -40
v  40 -60 -40
v  40  60 -40
v -40  60 -40
v -40 -60  40
v  40 -60  40
v  40  60  40
v -40  60  40
vt 0 0
vn 0 0 1
f 1/1/1 4/1/1 3/1/1 2/1/1
f 5 6 7 8
f 1 2 6 5
f 2 3 7 6
f 3 4 8 7
f -8 -4 -1 -5
